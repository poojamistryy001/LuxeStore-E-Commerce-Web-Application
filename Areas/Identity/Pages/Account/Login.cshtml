@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<style>
    .login-wrapper {
        min-height: calc(100vh - 140px);
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #ffffff; /* PURE WHITE */
    }

    .login-card {
        width: 380px;
        padding: 30px;
        border-radius: 10px;
        background: #ffffff;
        border: 1px solid #e5e5e5; /* subtle border instead of shadow */
    }

    .login-title {
        text-align: center;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .form-control {
        border-radius: 6px;
        padding: 10px;
    }

    .btn-login {
        background-color: #000;
        color: #fff;
        border-radius: 6px;
        padding: 10px;
    }

        .btn-login:hover {
            background-color: #333;
        }

    .login-footer {
        text-align: center;
        margin-top: 15px;
    }
</style>

<div class="login-wrapper">

    <div class="login-card">
        <h4 class="login-title">LogIn</h4>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center">
                🎉 @TempData["SuccessMessage"]
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <input asp-for="Input.Email" class="form-control" placeholder="Email address" />
            </div>

            <div class="mb-3">
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Password" />
            </div>

            <button type="submit" class="btn btn-login w-100">Login</button>

            <div class="login-footer">
                <a asp-page="./Register">Create Account</a>
            </div>
        </form>
    </div>

</div>