
@model LuxeStore.Models.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Shop";
}

<div class="row">

        <!-- LEFT FILTER SIDEBAR -->
        <div class="col-md-3">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Filters</h5>
                </div>
                <div class="card-body">
                    <form method="get" asp-controller="Product" asp-action="Index">
                        <!-- Search -->
                        <div class="mb-3">
                            <input type="text" name="search" class="form-control" placeholder="Search products..."
                                   value="@(ViewContext.HttpContext.Request.Query["search"])" />
                        </div>

                        <!-- Categories -->
                        <h6 class="mt-3">Categories</h6>
                        <div class="list-group mb-3">
                            <a class="list-group-item list-group-item-action @(string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["category"]) ? "active" : "")"
                               href="?category=">All</a>

                            @if (Model.Categories != null && Model.Categories.Any())
                            {
                                foreach (var cat in Model.Categories)
                                {
                                    <a class="list-group-item list-group-item-action @(ViewContext.HttpContext.Request.Query["category"] == cat.Name ? "active" : "")"
                                       href="?category=@cat.Name">@cat.Name</a>
                                }
                            }
                        </div>

                        <button type="submit" class="btn btn-warning w-100">Apply Filters</button>
                    </form>
                </div>
            </div>
        </div>

