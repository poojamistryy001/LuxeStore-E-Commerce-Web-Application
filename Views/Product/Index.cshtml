    <!-- RIGHT PRODUCTS -->
    <div class="col-md-9">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4>Products</h4>
            <span class="text-muted">@Model.Products.Count() items</span>
        </div>

        <div class="row row-cols-2 row-cols-md-3 g-4">
            @foreach (var p in Model.Products)
            {
                <div class="col">
                    <div class="card h-100 product-card shadow-sm">

                        <!-- IMAGE -->
                        <div class="text-center p-3 bg-light">
                            <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/products/default.jpg" : p.ImageUrl)"
                                 style="height:150px; object-fit:cover;" />
                        </div>

                        <!-- BODY -->
                        <div class="card-body">
                            <p class="text-muted small mb-1">@p.Category.Name</p>

                            <h6>@p.Name</h6>

                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <div>
                                    <strong>₹@p.Price.ToString("N0")</strong>
                                </div>

                                <!-- ACTIONS -->
                                <div class="d-flex gap-2">

                                    <!-- VIEW BUTTON -->
                                    <a asp-action="Detail" asp-route-id="@p.Id"
                                           class="btn btn-sm btn-outline-dark">
                                        View
                                    </a>

                                    <!-- CONDITION START -->
                                    @if (p.Category.Name == "Clothing")
                                    {
                                        <!-- SIZE DROPDOWN (ONLY FOR CLOTHING) -->
                                        <form asp-controller="Cart" asp-action="Add" method="post"
                                              class="d-flex gap-2 align-items-center">

                                            <input type="hidden" name="productId" value="@p.Id" />

                                            <select name="size" class="form-select form-select-sm"
                                                    style="width:70px" required>
                                                <option value="">Size</option>
                                                <option value="XS">XS</option>
                                                <option value="S">S</option>
                                                <option value="M">M</option>
                                                <option value="L">L</option>
                                                <option value="XL">XL</option>
                                                <option value="XXL">XXL</option>

                                                @if (p.Variants != null && p.Variants.Any())
                                                {
                                                    foreach (var v in p.Variants)
                                                    {
                                                        <option value="@v.Size">@v.Size</option>
                                                    }
                                                }
                                            </select>

                                            <button type="submit" class="btn btn-sm btn-dark">
                                                🛒
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <!-- NORMAL ADD BUTTON -->
                                        <form asp-controller="Cart" asp-action="Add" method="post">

                                            <input type="hidden" name="productId" value="@p.Id" />
                                            <input type="hidden" name="size" value="Default" />
                                            <input type="hidden" name="quantity" value="1" />

                                            <button type="submit" class="btn btn-sm btn-dark">
                                                🛒 Add
                                            </button>
                                        </form>
                                    }
                                    <!-- CONDITION END -->

                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>

    </div>
</div>