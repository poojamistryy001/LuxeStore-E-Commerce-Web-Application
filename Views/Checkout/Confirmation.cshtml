@model LuxeStore.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="text-center py-5">
    <div style="font-size:80px">✅</div>
    <h2 class="mt-3">Order Placed Successfully!</h2>
    <p class="text-muted">Your order <strong>@Model.OrderNumber</strong> has been confirmed.</p>
    <p>Total: <strong>₹@Model.TotalAmount.ToString("N0")</strong> · Payment: @Model.PaymentMethod</p>
    <div class="mt-4">
        <a asp-controller="Order" asp-action="MyOrders" class="btn btn-dark me-2">View My Orders</a>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark">Continue Shopping</a>
    </div>
</div>