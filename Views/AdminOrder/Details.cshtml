@model LuxeStore.Models.Order

@{
    ViewData["Title"] = "Orders";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>
    .timeline {
        display: flex;
        justify-content: space-between;
        margin: 40px 0;
        position: relative;
    }

    .timeline::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 0;
        width: 100%;
        height: 4px;
        background: #ddd;
        z-index: 1;
    }

    .step {
        position: relative;
        z-index: 2;
        text-align: center;
        width: 100%;
    }

    .step .circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #ccc;
        margin: auto;
        line-height: 40px;
        color: white;
        font-weight: bold;
    }

    .step.active .circle {
        background: #0d6efd;
    }

    .step.completed .circle {
        background: #198754;
    }

    .step p {
        margin-top: 10px;
        font-size: 14px;
    }
</style>
<div class="container mt-4">

    <h3>📦 Order Details (#@Model.OrderNumber)</h3>
    <a asp-action="Index" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left"></i> Back
    </a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @{
        int currentStep = 0;

        if (Model.Status == OrderStatus.Pending) currentStep = 1;
        else if (Model.Status == OrderStatus.Processing) currentStep = 2;
        else if (Model.Status == OrderStatus.Shipped) currentStep = 3;
        else if (Model.Status == OrderStatus.Delivered || Model.Status == OrderStatus.Completed) currentStep = 4;
    }

    <div class="timeline">

        <div class="step @(currentStep >= 1 ? "completed" : "")">
            <div class="circle">1</div>
            <p>Pending</p>
        </div>

        <div class="step @(currentStep >= 2 ? "completed" : "") @(currentStep == 2 ? "active" : "")">
            <div class="circle">2</div>
            <p>Processing</p>
        </div>

        <div class="step @(currentStep >= 3 ? "completed" : "") @(currentStep == 3 ? "active" : "")">
            <div class="circle">3</div>
            <p>Shipped</p>
        </div>

        <div class="step @(currentStep >= 4 ? "completed" : "") @(currentStep == 4 ? "active" : "")">
            <div class="circle">4</div>
            <p>Delivered</p>
        </div>

    </div>

    <h5 class="text-center mt-3">
        Current Status:
        <strong>@Model.Status</strong>
    </h5>

    <div class="row">

        <!-- LEFT -->
        <div class="col-md-6">

            <div class="card p-3 mb-3 shadow-sm">

                <h5>Customer Info</h5>

                <p><strong>Email:</strong> @Model.User?.Email</p>
                <p><strong>Name:</strong> @Model.ShippingName</p>

            </div>

            <div class="card p-3 shadow-sm">

                <h5>Shipping Address</h5>

                <p>@Model.ShippingAddress</p>
                <p>@Model.ShippingCity - @Model.ShippingPostalCode</p>
                <p>@Model.ShippingCountry</p>

            </div>

        </div>

        <!-- RIGHT -->
        <div class="col-md-6">

            <div class="card p-3 mb-3 shadow-sm">

                <h5>Payment</h5>

                <p><strong>Method:</strong> @Model.PaymentMethod</p>
                <p><strong>Status:</strong> @(Model.IsPaid ? "Paid ✅" : "Pending ❌")</p>

            </div>

            <div class="card p-3 shadow-sm">

                <h5>Order Summary</h5>

                <p>Subtotal: ₹ @Model.SubTotal</p>
                <p>Shipping: ₹ @Model.ShippingCost</p>
                <p>Tax: ₹ @Model.TaxAmount</p>

                <hr />

                <h5>Total: ₹ @Model.TotalAmount</h5>

            </div>

        </div>

    </div>

    <hr />

    <!-- STATUS UPDATE -->
    <form asp-action="UpdateStatus" method="post" class="mb-3">

        <input type="hidden" name="id" value="@Model.Id" />

        <select name="status" class="form-control w-25 mb-2">

            @foreach (var s in Enum.GetValues(typeof(LuxeStore.Models.OrderStatus)))
            {
                <option value="@s">@s</option>
            }

        </select>

        <button class="btn btn-success btn-sm">Update Status</button>

    </form>

    <hr />

    <!-- ITEMS -->
    <h5>🛒 Order Items</h5>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Product</th>
                <th>Size</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.OrderItems)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Size</td>
                    <td>₹ @item.UnitPrice</td>
                    <td>@item.Quantity</td>
                    <td>₹ @item.TotalPrice</td>
                </tr>
            }
        </tbody>

    </table>

</div>