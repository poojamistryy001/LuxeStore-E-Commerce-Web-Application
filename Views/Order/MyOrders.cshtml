@model IEnumerable<LuxeStore.Models.Order>
@using LuxeStore.Models
@{
    ViewData["Title"] = "My Orders";
}

<h2 class="mb-4">My Orders</h2>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <div style="font-size:80px">📦</div>
        <h4 class="text-muted">No orders yet</h4>
        <a asp-controller="Product" asp-action="Index" class="btn btn-dark mt-3">Start Shopping</a>
    </div>
}
else
{
    @foreach (var order in Model)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="mb-0">@order.OrderNumber</h6>
                    <span class="badge bg-@(order.Status == OrderStatus.Delivered ? "success" : order.Status == OrderStatus.Shipped ? "primary" : "warning") text-dark">
                        @order.Status
                    </span>
                    <span class="fw-bold">₹@order.TotalAmount.ToString("N0")</span>
                    <small class="text-muted">@order.CreatedAt.ToString("dd MMM yyyy")</small>
                </div>
                <div class="d-flex gap-2">
                    @foreach (var item in order.OrderItems)
                    {
                        <span class="badge bg-light text-dark border">@item.ProductName (@item.Size) ×@item.Quantity</span>
                    }
                </div>
            </div>
        </div>
    }
}