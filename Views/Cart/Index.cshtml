@model LuxeStore.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<h2 class="mb-4">Shopping Cart</h2>

@if (Model.Cart == null || !Model.Cart.CartItems.Any())
{
    <div class="text-center py-5">
        <div style="font-size:80px">🛒</div>
        <h4 class="text-muted">Your cart is empty</h4>
        <a asp-controller="Product" asp-action="Index" class="btn btn-dark mt-3">Start Shopping</a>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-8">
            @foreach (var item in Model.Cart.CartItems)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div style="font-size:50px">📦</div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">@item.Product.Name</h6>
                            <small class="text-muted">Size: @item.Size</small>
                            <div class="d-flex align-items-center gap-2 mt-2">
                                <form asp-action="UpdateQty" method="post" class="d-inline">
                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="10" class="form-control form-control-sm" style="width:65px" onchange="this.form.submit()" />
                                </form>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold fs-5">₹@((item.UnitPrice * item.Quantity).ToString("N0"))</div>
                            <form asp-action="Remove" method="post" class="mt-2">
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <button class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Order Summary</h5>
                    <div class="d-flex justify-content-between mb-2"><span>Subtotal</span><span>₹@Model.SubTotal.ToString("N0")</span></div>
                    <div class="d-flex justify-content-between mb-2"><span>Shipping</span><span>@(Model.Shipping == 0 ? "Free" : "₹" + Model.Shipping)</span></div>
                    <div class="d-flex justify-content-between mb-2"><span>GST (18%)</span><span>₹@Model.Tax.ToString("N0")</span></div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-5"><span>Total</span><span>₹@Model.Total.ToString("N0")</span></div>
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-dark w-100 mt-3">Proceed to Checkout →</a>
                </div>
            </div>
        </div>
    </div>
}