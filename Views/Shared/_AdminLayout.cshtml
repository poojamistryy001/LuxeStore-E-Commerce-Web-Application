@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LuxeStore Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
        overflow-x: hidden;
        font-family: 'Segoe UI', sans-serif;
        }

        .sidebar {
        width: 240px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        background-color: #343a40;
        padding-top: 20px;
        overflow-y: auto; 
        }

        .sidebar a, .sidebar .nav-link, .sidebar button.nav-link {
        color: #fff;
        display: flex;
        align-items: center;
        width: 100%;
        text-align: left;
        padding: 12px 20px;
        text-decoration: none;
        margin-bottom: 5px;
        border-radius: 4px;
        transition: 0.3s;
        }

        .sidebar a:hover, .sidebar .nav-link.active {
        background-color: #007bff;
        }

        .sidebar i {
        margin-right: 10px;
        }

        .collapse-inner a {
        padding-left: 40px;
        background-color: #495057;
        }

        .content {
        margin-left: 240px;
        padding: 20px;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <h4 class="text-center text-white mb-4">💎 Luxe Admin</h4>

        <!-- Dashboard -->
        <a class="nav-link @(ViewBag.ActivePage == "Dashboard" ? "active" : "")"
               asp-controller="AdminDashboard" asp-action="Index">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>

        <!-- CATEGORIES -->
        <a class="nav-link d-flex justify-content-between align-items-center"
               data-bs-toggle="collapse" href="#categoryMenu">
            <span><i class="bi bi-tags"></i> Categories</span>
            <i class="bi bi-chevron-down"></i>
        </a>

        <div class="collapse @(ViewBag.ActivePage == "Categories" ? "show" : "")" id="categoryMenu">
            <div class="collapse-inner">

                <a class="nav-link @(ViewBag.SubPage == "AddCategory" ? "active" : "")"
                       asp-controller="AdminCategory" asp-action="Create">
                    Add Category
                </a>

                <a class="nav-link @(ViewBag.SubPage == "ListCategories" ? "active" : "")"
                       asp-controller="AdminCategory" asp-action="Index">
                    List Categories
                </a>

            </div>
        </div>

        <!-- PRODUCTS -->
        <a class="nav-link d-flex justify-content-between align-items-center"
               data-bs-toggle="collapse" href="#productsMenu">
            <span><i class="bi bi-box-seam"></i> Products</span>
            <i class="bi bi-chevron-down"></i>
        </a>

        <div class="collapse @(ViewBag.ActivePage == "Products" ? "show" : "")" id="productsMenu">
            <div class="collapse-inner">

                <a class="nav-link @(ViewBag.SubPage == "AddProduct" ? "active" : "")"
                       asp-controller="AdminProduct" asp-action="Create">
                    Add Product
                </a>

                <a class="nav-link @(ViewBag.SubPage == "ListProducts" ? "active" : "")"
                       asp-controller="AdminProduct" asp-action="Index">
                    List Products
                </a>

            </div>
        </div>

        <!-- ORDERS -->
        <!-- ORDERS -->
        <a class="nav-link d-flex justify-content-between align-items-center"
               data-bs-toggle="collapse" href="#ordersMenu">
            <span><i class="bi bi-receipt"></i> Orders</span>
            <i class="bi bi-chevron-down"></i>
        </a>

        <div class="collapse @(ViewBag.ActivePage == "Orders" ? "show" : "")" id="ordersMenu">
            <div class="collapse-inner">

                <a class="nav-link @(ViewBag.SubPage == "PendingOrders" ? "active" : "")"
                       asp-controller="AdminOrder" asp-action="Pending">
                    Pending Orders
                </a>

                <a class="nav-link @(ViewBag.SubPage == "AllOrders" ? "active" : "")"
                       asp-controller="AdminOrder" asp-action="Index">
                    All Orders
                </a>

            </div>
        </div>

        <!-- CUSTOMERS -->
        <a class="nav-link d-flex justify-content-between align-items-center"
               data-bs-toggle="collapse" href="#customersMenu">
            <span><i class="bi bi-people"></i> Customers</span>
            <i class="bi bi-chevron-down"></i>
        </a>

        <div class="collapse @(ViewBag.ActivePage == "Customers" ? "show" : "")" id="customersMenu">
            <div class="collapse-inner">
                <a class="nav-link @(ViewBag.SubPage == "ListCustomers" ? "active" : "")"
                       asp-controller="AdminCustomer" asp-action="Index">
                    List Customers
                </a>

            </div>
        </div>

        <!-- LOGOUT -->
        <div class="mt-3 px-3">
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="/"
                  method="post">
      
                <button type="submit" class="btn btn-danger w-100">
                    Logout
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="content">

        <!-- Top Navbar -->
        <nav class="navbar navbar-light bg-light shadow-sm mb-4 rounded">
            <div class="container-fluid">
                <span class="navbar-brand">@ViewData["Title"]</span>

                <span class="fw-semibold">
                    👤 @User.Identity?.Name
                </span>
            </div>
        </nav>

        @RenderBody()
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>